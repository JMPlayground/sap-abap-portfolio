<mvc:View controllerName="ncode.zncl04ljm.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
xmlns:core="sap.ui.core">
    <Page id="page" title="{i18n>title}">


            <HBox
                    alignItems="Center"
                    wrap="Wrap"
                >
                    <Select
                        id="searchField"
                        selectedKey="ProductName"

                    >
                        <items>
                            <core:Item
                                key="ProductID"
                                text="상품 번호"
                            />
                            <core:Item
                                key="ProductName"
                                text="상품명"
                            />
                            <core:Item
                                key="QuantityPerUnit"
                                text="포장 단위"
                            />
                        </items>
                    </Select>
                    <Input
                        id="searchText"
                        placeholder="검색어 입력"
                        submit="onSearch"
                    />
                    <Button
                        text="검색"
                        type="Emphasized"
                        press="onSearch"
                    />

                </HBox>

            <Table
                    id="productTable"
                    growing="true"
                    growingThreshold="10"
                    noDataText="조회된 상품이 없습니다"
                    items="{/Products}"
                >
                    
                    <columns>
                        <Column >
                            <Text text="상품 번호" />
                        </Column>
                        <Column>
                            <Text text="상품명" />
                        </Column>
                        <Column>
                            <Text text="포장 단위" />
                        </Column>
                        <Column
                            hAlign="End"
                            
                        >
                            <Text text="단가" />
                        </Column>
                        <Column
                            hAlign="End"
                            
                        >
                            <Text text="재고" />
                        </Column>
                        <Column >
                            <Text text="중단 여부" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            type="Navigation"
                            press="onRowPress"
                        >
                            <cells>
                                <ObjectIdentifier title="{ProductID}" />
                                <Text text="{ProductName}" />
                                <Text text="{QuantityPerUnit}" />
                                <ObjectNumber
                                    number="{UnitPrice}"
                                    unit="USD"
                                />
                                <ObjectNumber number="{UnitsInStock}" />
                                <ObjectStatus
                                    text="{= ${Discontinued} ? '중단' : '판매 중'}"
                                    state="{= ${Discontinued} ? 'Error' : 'Success'}"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>


    </Page>
</mvc:View>