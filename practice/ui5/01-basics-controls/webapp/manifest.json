{
  "_version": "1.60.0",
  "sap.app": {
    "id": "ncode.zncl401",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "afda3ff4-f3ab-45d2-8eaf-2df58c7c008f"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false, 
    "dependencies": {
      "minUI5Version": "1.120.52",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ncode.zncl401.i18n.i18n"
        }
      }
    },
    "handleValidation": true,
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "ncode.zncl401.view",
        "async": true,
        "viewPath": "ncode.zncl401.view"
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": ":?query:",
          "target": [
            "TargetView1"
  
     ]
    },
  {
  "name":"RouteDetail",
  "pattern":
  "Detail/{studentIndex}/{scoreIndex}",
    "target":["TargetDetail"]
  
  }
],
      "targets": {
        "TargetView1": {
          "id": "View2",
          "name": "View2"
        },
      "TargetDetail":{
        "id": "Detail",
        "name": "Detail"
      }
    }
  },
    "rootView": {
      "viewName": "ncode.zncl401.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
