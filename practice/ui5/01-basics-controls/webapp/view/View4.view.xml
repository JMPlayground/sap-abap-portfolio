<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:t="sap.ui.table" xmlns:modes="sap.ui.table.rowmodes" controllerName="ncode.zncl401.controller.View4">
    <Page id="page4" title="View, Controller">
    <Page title = "고객 조회">   
     <content>
    
    <t:Table
            id="idTableCustomers"
            rows="{/customers}"
            selectionMode="Single"
            rowSelectionChange="onRowSelectionChange"
            rowActionCount="1"
        >
        <t:rowMode>
                <modes:Fixed rowCount="5" />
            </t:rowMode>
        <t:extension>
                <OverflowToolbar design="Transparent">
                    <Title
                        text="Customers"
                        level="H2"
                    />
                    <ToolbarSpacer />

                    <SearchField
                        id="searchCustomer"
                        width="12rem"
                        placeholder="이름 검색"
                        liveChange="onFilter"
                    />

                    <Select
                        id="filterStatus"
                        width="9rem"
                        change="onFilter"
                    >
                        <core:Item
                            key=""
                            text="전체"
                        />
                        <core:Item
                            key="성인"
                            text="성인"
                        />
                        <core:Item
                            key="미성년자"
                            text="미성년자"
                        />
                    </Select>

                    <Button
                        icon="sap-icon://sort"
                        text="이름순"
                        press="onSortName"
                    />

                    <Button
                        icon="sap-icon://sort"
                        text="나이순"
                        press="onSortAge"
                    />
                </OverflowToolbar>
            </t:extension>
            <t:columns>
                <t:Column>
                    <Label text="CustomerName" />
                    <t:template>
                        <Text text="{name}" />
                    </t:template>
                </t:Column>
                <t:Column>
                    <Label text="Age" />
                    <t:template>
                        <Input value= "{ 
                                         path      : 'age',
                                         type       : 'sap.ui.model.type.Integer' ,
                                         constraints : {minimum: 10, maximum: 100 } }" />

                    </t:template>
                </t:Column>
                <t:Column>
                    <Label text="Gubun" />
                    <t:template>
                        <!-- 조건 ? 참일 때 결과 : 거짓일 때 결과 -->
                        <ObjectStatus
                            text        = "{adultStatus}"
                            state       = "{= ${age} >= 20 ? 'Success' : 'Error' }" /> 
                         
                    </t:template>
                </t:Column>
                <t:Column>
                    <Label text="Tel" />
                    <t:template>
                        <Text text= "{path: 'phone',
                                      formatter: '.formatPhone'
            
                        }"
                        
                             /> 
                    </t:template>
                </t:Column>
                <t:Column hAlign="End">
             <Label text="구매건수" />
                <t:template>
        <Text text="{ path: '_purchaseList', formatter: '.formatPurchaseCount' }" />
                </t:template>
                </t:Column>
            </t:columns>
        </t:Table>


    </content>
    <headerContent>


    </headerContent>

</Page>
    </Page>
</mvc:View>