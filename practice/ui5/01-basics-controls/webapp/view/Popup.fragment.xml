<core:FragmentDefinition
    xmlns                   ="sap.m"
    xmlns:core              ="sap.ui.core"
>
    <Dialog
        id                  ="idPopup"
        title               ="Popup View"
        titleAlignment      ="Center" 
    >
        <content>
            <VBox class     ="sapUiSmallMargin">
                <Label text ="Popup" />
                <Input
                    id      ="inpPopup"
                    value   ="Popup Value"
                    width   ="100%"
                />
            </VBox>
        </content>

        <buttons>
            <!-- 팝업 닫기 버튼 -->
            <Button
                text        ="Close"
                type        ="Transparent"
                press       =".onClose"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>