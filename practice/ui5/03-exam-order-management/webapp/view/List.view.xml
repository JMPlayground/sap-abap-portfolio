<mvc:View xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="ncode.zncl0402ljm.controller.List">
    <!--
    ================================================================
     List.view.xml : 생산 오더 조회 (sap.m.Table · Growing 10)
    ================================================================
    -->
    <Page id="pageList" title="생산 오더 조회">
        <content>

            <!-- ===================== 검색 조건 ===================== -->
            <Toolbar design="Transparent">
                <Label text="검색 조건" class="sapUiSmallMarginBegin"/>
            </Toolbar>

            <HBox alignItems="End" wrap="Wrap" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">

                <VBox class="sapUiSmallMarginEnd">
                    <Label text="검색 기준" labelFor="cOrderCombo"/>
                    <ComboBox id="cOrderCombo"
                        width="180px"
                        placeholder="검색 기준을 정하세요"
                        selectedKey="OrderID">
                        <items>
                            <core:Item key="OrderID"    text="생산 오더 번호"/>
                            <core:Item key="Customer"   text="고객명"/>
                            <core:Item key="SalesOrder" text="판매 오더 번호"/>
                        </items>
                    </ComboBox>
                </VBox>

                <VBox class="sapUiSmallMarginEnd">
                    <Label text="검색어" labelFor="inpKeyword"/>
                    <!-- submit : 입력 후 Enter 로도 검색 -->
                    <Input id="inpKeyword"
                        width="240px"
                        placeholder="검색어 입력"
                        submit=".onSearch"/>
                </VBox>

                <VBox class="sapUiSmallMarginEnd">
                    <Label text="생산 상태" labelFor="selStatus"/>
                    <Select id="selStatus" width="140px" selectedKey="" change=".onSearch">
                        <items>
                            <core:Item key=""   text="전체"/>
                            <core:Item key="01" text="계획"/>
                            <core:Item key="02" text="진행 중"/>
                            <core:Item key="03" text="완료"/>
                            <core:Item key="09" text="보류"/>
                        </items>
                    </Select>
                </VBox>

                <Button text="검색"
                    type="Emphasized"
                    icon="sap-icon://search"
                    press=".onSearch"
                    class="sapUiTinyMarginEnd"/>
                <Button text="초기화"
                    icon="sap-icon://reset"
                    press=".onReset"/>
            </HBox>

            <!-- ===================== 메인 테이블 ===================== -->
            <Table id="idOrderTable"
                items="{/Orders}"
                mode="SingleSelectMaster"
                selectionChange=".onOrderSelect"
                updateFinished=".onUpdateFinished"
                noDataText="조회된 데이터가 없습니다."
                growing="true"
                growingThreshold="10"
                class="sapUiSmallMarginTop">

                <headerToolbar>
                    <OverflowToolbar>
                        <!-- 건수는 updateFinished 에서 갱신 -->
                        <Title id="tableTitle" text="생산 오더 목록" level="H2"/>
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column><Text text="생산 오더"/></Column>
                    <Column><Text text="판매 오더"/></Column>
                    <Column><Text text="고객"/></Column>
                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="대표 자재명"/></Column>
                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="대표 계획수량"/></Column>
                    <Column><Text text="생산 상태"/></Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{OrderID}"/>
                            <Text text="{SalesOrder}"/>
                            <Text text="{Customer}"/>
                            <Text text="{_Items/0/MaterialName}"/>
                            <ObjectNumber
                                number="{ path : '_Items/0/PlannedQty', formatter : '.formatter.number' }"
                                unit="{_Items/0/Unit}"/>
                            <ObjectStatus
                                text="{ path : 'Status', formatter : '.formatter.statusText' }"
                                state="{ path : 'Status', formatter : '.formatter.statusState' }"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
