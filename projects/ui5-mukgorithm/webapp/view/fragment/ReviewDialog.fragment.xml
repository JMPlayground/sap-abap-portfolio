
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="idReviewDialog"
        class="mkReviewDialog"
        contentWidth="480px"
        stretch="{device>/system/phone}"
        horizontalScrolling="false">

        <content>
            <VBox class="mkReviewBody">

                <!-- 리뷰 목록 상단 -->
                <HBox
                    class="mkReviewIntro"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    width="100%">

                    <VBox class="mkReviewIntroText">
                        <Title
                            text="{StoreName}"
                            level="H3"
                            class="mkReviewTitle" />

                        <Text
                            text="먹어본 메뉴와 솔직한 후기"
                            class="mkReviewSubtitle" />
                    </VBox>

                    <!-- 캐릭터 이미지 -->
                    <HBox
                        class="mkReviewMascot"
                        width="56px"
                        height="56px" />

                </HBox>

                <!-- 리뷰 목록 -->
                <List
                    id="idReviewList"
                    items="{
                        path: 'Reviews',
                        templateShareable: false
                    }"
                    showSeparators="None"
                    noDataText="아직 등록된 리뷰가 없어요."
                    class="mkReviewList">

                    <CustomListItem
                        type="Active"
                        press=".onPanelPress"
                        class="mkReviewItem">

                        <VBox class="mkReviewItemContent">

                            <!-- 메뉴명과 상세보기 -->
                            <HBox
                                justifyContent="SpaceBetween"
                                alignItems="Center"
                                class="mkReviewItemHeader">

                                <Title
                                    text="{MenuName}"
                                    level="H4"
                                    class="mkReviewMenuName" />

                                <core:Icon
                                    src="sap-icon://navigation-right-arrow"
                                    class="mkReviewArrow" />

                            </HBox>

                            <!-- 별점과 방문일 -->
                            <HBox
                                justifyContent="SpaceBetween"
                                alignItems="Center"
                                class="mkReviewMetaRow">

                                <RatingIndicator
                                    value="{Rating}"
                                    maxValue="5"
                                    displayOnly="true"
                                    iconSize="1rem"
                                    class="customRating mkReviewRating" />

                                <Text
                                    text="{VisitDate}"
                                    class="mkReviewDate" />

                            </HBox>

                            <!-- 리뷰 내용 미리보기 -->
                            <Text
                                text="{ReviewText}"
                                wrapping="true"
                                maxLines="2"
                                class="mkReviewDescription" />

                            <!-- 가격 -->
                            <HBox
                                alignItems="Center"
                                class="mkReviewPriceRow">

                                <Text
                                    text="메뉴 가격"
                                    width="85px"
                                    class="mkReviewPriceLabel" />

                                <HBox
                                    alignItems="Center"
                                    class="mkReviewPriceValue">

                                    <Text
                                        text="{
                                            path: 'Price',
                                            type: 'sap.ui.model.type.Integer',
                                            formatOptions: {
                                                groupingEnabled: true
                                            }
                                        }"
                                        class="mkReviewPriceText" />

                                    <Text
                                        text="원"
                                        class="mkReviewPriceText" />

                                </HBox>

                            </HBox>

                        </VBox>

                    </CustomListItem>

                </List>

            </VBox>
        </content>

        <!-- 하단 버튼 -->
        <beginButton>
            <Button
                id="idCreateBtn"
                text="리뷰 작성"
                icon="sap-icon://add"
                type="Emphasized"
                press=".onCreatePress"
                class="mkReviewCreateBtn" />
        </beginButton>

        <endButton>
            <Button
                text="닫기"
                type="Transparent"
                press=".onReviewDialogClose"
                class="mkReviewCloseBtn" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>
